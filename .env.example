# --- Database (SQLite for local dev) ---
DATABASE_URL="file:./dev.db"

# --- Auth ---
JWT_SECRET="change-me-in-production-please-use-a-long-random-string"
SESSION_TTL_SECONDS=604800
# true = Secure cookies (HTTPS only). false = allow cookies on plain HTTP (IP/VPS demos).
COOKIE_SECURE="false"

# --- AI feedback / marking provider ---
# One of: auto | openrouter | ollama | groq | openai | mock
AI_PROVIDER="openrouter"

# OpenRouter (https://openrouter.ai) — used for all skills
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_SITE_URL="http://localhost:3001"
OPENROUTER_APP_NAME="LEARN"

# Local free LLM (Ollama)
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2"

# Free online Groq
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_BASE_URL="https://api.groq.com/openai/v1"

# OpenAI / compatible
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"

# --- Speech-to-text ---
# auto = local Whisper if running, else OpenRouter (recommended)
# whisper | openrouter | mock
STT_PROVIDER="auto"
WHISPER_STT_URL="http://127.0.0.1:8787"
WHISPER_MODEL="small.en"
# Used when STT_PROVIDER=openrouter or auto falls back
OPENROUTER_STT_MODEL="openai/whisper-1"
AI_TIMEOUT_MS=35000
VOSK_MODEL_PATH="./models/vosk-model-small-en-us-0.15"

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
